rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'elakhwaelmthdon@gmail.com';
    }

    function isValidMenuCategory(cat) {
      return cat in ['GROUND_COFFEE', 'BEVERAGE'];
    }

    function isValidMenuItem(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.description is string && data.description.size() <= 250 &&
             isValidMenuCategory(data.category) &&
             data.unitLabel is string && data.unitLabel.size() >= 1 && data.unitLabel.size() <= 40 &&
             (data.price is int || data.price is float) && data.price > 0 && data.price <= 100000 &&
             data.available is bool &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidOrderStatus(status) {
      return status in ['PENDING', 'PREPARING', 'READY', 'COMPLETED', 'CANCELLED'];
    }

    function isValidOrder(data) {
      return data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 20 &&
             data.customerId is string && data.customerId.size() >= 1 && data.customerId.size() <= 128 &&
             data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 60 &&
             data.customerPhone is string && data.customerPhone.size() >= 7 && data.customerPhone.size() <= 20 &&
             data.customerEmail is string && data.customerEmail.size() <= 100 &&
             data.notes is string && data.notes.size() <= 250 &&
             data.items is list && data.items.size() >= 1 && data.items.size() <= 30 &&
             data.items[0] is map &&
             (data.totalAmount is int || data.totalAmount is float) && data.totalAmount > 0 && data.totalAmount <= 500000 &&
             isValidOrderStatus(data.status) &&
             data.paid is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /menu_items/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId) && (isOwner() || existing().available == true);
      allow list: if isSignedIn() && (isOwner() || existing().available == true);

      allow create: if isOwner() &&
                       isValidId(itemId) &&
                       incoming().keys().hasAll(['name', 'description', 'category', 'unitLabel', 'price', 'available', 'sortOrder', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['name', 'description', 'category', 'unitLabel', 'price', 'available', 'sortOrder', 'createdAt', 'updatedAt']) &&
                       isValidMenuItem(incoming());

      allow update: if isOwner() &&
                       isValidId(itemId) &&
                       isValidMenuItem(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'category', 'unitLabel', 'price', 'available', 'sortOrder', 'updatedAt']);

      allow delete: if isOwner() && isValidId(itemId);
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (isOwner() || existing().customerId == request.auth.uid);
      allow list: if isSignedIn() && (isOwner() || existing().customerId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(orderId) &&
                       incoming().keys().hasAll(['orderNumber', 'customerId', 'customerName', 'customerPhone', 'customerEmail', 'notes', 'items', 'totalAmount', 'status', 'paid', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['orderNumber', 'customerId', 'customerName', 'customerPhone', 'customerEmail', 'notes', 'items', 'totalAmount', 'status', 'paid', 'createdAt', 'updatedAt']) &&
                       incoming().customerId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().paid == false &&
                       isValidOrder(incoming());

      allow update: if isSignedIn() &&
                       isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       incoming().customerId == existing().customerId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (
                           isOwner() &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paid', 'notes', 'updatedAt'])
                         ) ||
                         (
                           existing().customerId == request.auth.uid &&
                           existing().status == 'PENDING' &&
                           incoming().status == 'CANCELLED' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                         )
                       );

      allow delete: if isOwner() && isValidId(orderId);
    }

    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'phone', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'phone', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
    }
  }
}
