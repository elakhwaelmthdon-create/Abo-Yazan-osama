{
  "entities": {
    "MenuItem": {
      "title": "MenuItem",
      "description": "A coffee or beverage product in Bon Yazan roastery & cafe menu",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name of the coffee or beverage item (1-80 chars)"
        },
        "description": {
          "type": "string",
          "description": "Roast, blend, or drink description (0-250 chars)"
        },
        "category": {
          "type": "string",
          "enum": ["GROUND_COFFEE", "BEVERAGE"],
          "description": "Product category: GROUND_COFFEE or BEVERAGE"
        },
        "unitLabel": {
          "type": "string",
          "description": "Portion or weight label (1-40 chars)"
        },
        "price": {
          "type": "number",
          "description": "Item price in EGP (> 0 and <= 100000)"
        },
        "available": {
          "type": "boolean",
          "description": "Whether the item is currently in stock and visible to customers"
        },
        "sortOrder": {
          "type": "integer",
          "description": "Menu display sort index (0-10000)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "name",
        "description",
        "category",
        "unitLabel",
        "price",
        "available",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order placed at Bon Yazan coffee shop",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "description": "Short pickup order number (3-20 chars)"
        },
        "customerId": {
          "type": "string",
          "description": "Authenticated customer Firebase UID"
        },
        "customerName": {
          "type": "string",
          "description": "Customer full name for pickup (2-60 chars)"
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer phone number (7-20 chars)"
        },
        "customerEmail": {
          "type": "string",
          "description": "Customer Google email (0-100 chars)"
        },
        "notes": {
          "type": "string",
          "description": "Preparation or grind notes (0-250 chars)"
        },
        "items": {
          "type": "array",
          "description": "Bounded list of ordered line-item maps (1-30 items)"
        },
        "totalAmount": {
          "type": "number",
          "description": "Total order price in EGP (> 0 and <= 500000)"
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "PREPARING", "READY", "COMPLETED", "CANCELLED"],
          "description": "Order fulfillment status"
        },
        "paid": {
          "type": "boolean",
          "description": "Whether the cashier has collected payment"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "orderNumber",
        "customerId",
        "customerName",
        "customerPhone",
        "customerEmail",
        "notes",
        "items",
        "totalAmount",
        "status",
        "paid",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Saved customer contact details for quick checkout",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID"
        },
        "displayName": {
          "type": "string",
          "description": "Customer name (1-60 chars)"
        },
        "phone": {
          "type": "string",
          "description": "Customer phone number (0-20 chars)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "userId",
        "displayName",
        "phone",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Shop menu items managed by the owner and browsed by customers"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders tracked by both the customer and the shop owner/cashier"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer contact profiles scoped strictly by userId"
    }
  }
}
